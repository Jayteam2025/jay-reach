# Copier ce fichier vers /etc/jay-reach/worker.env (root:root, chmod 600) et le remplir à la main.
# Ne jamais commiter le fichier rempli.

# Connexion Postgres du projet Supabase. Connexion directe ou pooler en mode session (port 5432).
# Jamais le pooler en mode transaction (port 6543) : pg-boss ne le supporte pas.
DATABASE_URL=

# Clé du coffre des clés fournisseurs (app.get_credential). Obligatoire : sans elle aucun job
# ne trouve de clé et le moteur ne fait rien.
ENCRYPTION_KEY=

# URL publique de l'application web (liens dans les notifications).
APP_URL=

# Cadence (millisecondes). Défauts : production 15 min, séquences 60 s, relevé des demandes 10 s.
DISCOVER_INTERVAL_MS=900000
TICK_INTERVAL_MS=60000
REQUESTED_RUN_POLL_MS=10000

# Plafonds de repli si aucun plafond n'est réglé dans l'écran Fournisseurs (0 = pause).
ENRICH_DAILY_CAP=50
SCORE_DAILY_CAP=300

# Âge maximal d'un signal avant écart automatique (jours).
SIGNAL_MAX_AGE_DAYS=14

# Personnes contactées par entreprise et par jour.
ACCOUNT_PEOPLE_PER_DAY=2

# Attente maximale d'un enrichissement (millisecondes).
ENRICH_MAX_WAIT_MS=40000

# Identifiant stable de cette instance dans engine_status.instance_id (optionnel, défaut "worker").
# Utile seulement si plusieurs instances distinctes doivent un jour cohabiter dans la même base.
# ENGINE_INSTANCE_ID=worker

# Lecture directe des réponses par Microsoft Graph. Se configure dans l'application :
# Fournisseurs -> Microsoft Graph. Ces trois variables ne sont qu'un repli, utilisé seulement
# quand rien n'y est saisi, et il en faut alors les trois. Ne servent qu'aux organisations
# ayant au moins une boîte avec la lecture directe activée dans Réglages -> Expéditeurs :
# sans boîte activée, la relève ne démarre pas, quoi qu'il y ait ici.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=

# Canal LinkedIn exécuté côté serveur (lots 4a et 4b : collecte et envoi). Seulement les CLÉS ici : aucune valeur ne se
# commite, et le fichier rempli reste hors du dépôt.
# JAY_REACH_LINKEDIN : mettre 1 pour activer le canal : les commandes `jay-reach linkedin ...` ET tout
# l'envoi. Clé vide, absente ou différente de 1 : le minuteur d'envoi ne démarre pas et le handler
# sort sur un avertissement, SANS rien envoyer et SANS erreur visible (les actions restent pending).
JAY_REACH_LINKEDIN=
# LINKEDIN_ENVOI_POLL_MS (optionnel) : cadence d'évaluation de l'envoi, en ms. Défaut 60000.
# Absente, vide, illisible ou sous 10000 : le défaut ; au-dessus de 300000 : ramenée à 300000.
# LINKEDIN_ENVOI_POLL_MS=
# LINKEDIN_BROWSER_URL : adresse DevTools du service `navigateur` dans le réseau du compose (http://navigateur:9223).
LINKEDIN_BROWSER_URL=
# Identifiants du proxy LinkedIn, présentés par CDP (Chromium les refuse dans l'URL).
# L'ADRESSE du proxy (LINKEDIN_PROXY_URL) ne va PAS ici : elle vit dans /etc/jay-reach/navigateur.env.
LINKEDIN_PROXY_USER=
LINKEDIN_PROXY_PASSWORD=
# JAY_REACH_ORGANISATION_ID (optionnel) : à poser si la base porte plusieurs organisations.
# JAY_REACH_ORGANISATION_ID=

# GIT_SHA, NODE_ENV et HEARTBEAT_FILE sont posés par docker-compose.yml : ne pas les mettre ici.
