{
  "name": "@jay-reach/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node ../../scripts/package-extension.mjs",
    "dev": "next dev --port 3000",
    "dev:e2e": "next dev --port 3100",
    "prebuild": "node ../../scripts/package-extension.mjs",
    "build": "next build",
    "start": "next start --port 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@jay-reach/core": "workspace:*",
    "@jay-reach/i18n": "workspace:*",
    "@jay-reach/ui": "workspace:*",
    "@jay-reach/worker": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "next": "^15.1.3",
    "next-intl": "^3.26.3",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "intl-messageformat": "10.7.18",
    "typescript": "^5.7.2"
  }
}
