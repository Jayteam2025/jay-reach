{
  "name": "@jay-reach/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=../../.env --import tsx --watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=dist/index.js --packages=external",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@jay-reach/core": "workspace:*",
    "@jay-reach/db": "workspace:*",
    "@jay-reach/providers": "workspace:*",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "esbuild": "^0.24.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "exports": {
    "./credentials": "./src/credentials.ts",
    "./db": "./src/db.ts",
    "./domain-patterns": "./src/domain-patterns.ts",
    "./enrichment-persist": "./src/enrichment-persist.ts",
    "./handlers/*": "./src/handlers/*.ts",
    "./producer": "./src/producer.ts",
    "./provider-cache": "./src/provider-cache.ts",
    "./runtime": "./src/runtime.ts",
    "./scorer-anthropic": "./src/scorer-anthropic.ts",
    "./traitements": "./src/traitements.ts"
  }
}
