{
  "name": "jay-reach",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12",
    "pnpm": ">=10"
  },
  "scripts": {
    "dev": "pnpm --filter @jay-reach/web dev",
    "build": "pnpm -r --filter \"./packages/*\" build && pnpm --filter @jay-reach/web build && pnpm --filter @jay-reach/worker build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "reach:scaffold": "node scripts/scaffold-provider.mjs",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "eslint-plugin-i18next": "^6.1.1",
    "prettier": "^3.4.2",
    "supabase": "^2.115.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
