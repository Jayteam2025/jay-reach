# =============================================================
# Jay Reach — configuration
# Copier en .env et remplir. Ne jamais committer le .env.
# =============================================================

# --- Application ---------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
DEFAULT_LOCALE=fr                 # fr | en | nl
# Générer : openssl rand -base64 32
ENCRYPTION_KEY=

# --- Base de données -----------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:54322/postgres

# --- Supabase ------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Contourne la RLS. Serveur et worker uniquement, jamais côté client.
SUPABASE_SERVICE_ROLE_KEY=

# --- Modèle de langage ---------------------------------------
# Un seul suffit. Ollama pour un fonctionnement 100 % local.
AI_PROVIDER=anthropic             # anthropic | openai | ollama
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# --- Sources de signaux --------------------------------------
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
APIFY_TOKEN=

# --- Enrichissement ------------------------------------------
# FullEnrich et Dropcontact : coordonnées des personnes.
FULLENRICH_API_KEY=
DROPCONTACT_API_KEY=
# Annuaire légal : identité d'entreprise, SIREN, adresses d'établissement.
# C'est cette source qui alimente le canal courrier, pas les enrichisseurs de contacts.
LEGAL_REGISTRY_API_KEY=

# --- Canal email ---------------------------------------------
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=

# --- Canal LinkedIn ------------------------------------------
# manual = aucune automatisation, export des actions à faire à la main.
LINKEDIN_PROVIDER=manual          # manual | unipile
UNIPILE_API_KEY=
UNIPILE_DSN=

# --- Boîte de réception --------------------------------------
# Synchronisation bidirectionnelle. Seuls les messages correspondant
# à un contact connu sont stockés. Le reste est ignoré sans trace.
INBOX_PROVIDER=unipile
INBOX_SYNC_ENABLED=false

# --- Canal courrier ------------------------------------------
MANUSCRY_API_KEY=
# Plafond mensuel en euros, par organisation. 0 = canal désactivé.
LETTER_MONTHLY_BUDGET_EUR=0

# --- CRM -----------------------------------------------------
# positive_only = seuls les contacts ayant répondu positivement montent.
CRM_PUSH_POLICY=positive_only     # positive_only | manual_only | all
CRM_PROVIDER=                     # jaycrm | webhook | csv_export
CRM_WEBHOOK_URL=
CRM_WEBHOOK_SECRET=

# --- Garde-fous ----------------------------------------------
# Plafonds absolus. La configuration en base ne peut pas les dépasser.
MAX_LINKEDIN_INVITES_PER_DAY=20
MAX_LINKEDIN_MESSAGES_PER_DAY=60
MAX_EMAILS_PER_SENDER_PER_DAY=100
# Arrêt global immédiat. Rien n'est perdu, tout est reporté.
KILL_SWITCH=false
# Envoi email et LinkedIn sans validation. Le courrier reste toujours validé.
AUTO_SEND_EMAIL=true
AUTO_SEND_LINKEDIN=true
